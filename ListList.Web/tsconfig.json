{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "sourceMap": true,
    "types": ["node"],
    "outDir": "./dist"
  },
  "include": ["src"]
}